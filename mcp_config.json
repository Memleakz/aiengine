{
  "mcp_servers": {
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-sqlite",
        "--db",
        "./my_database.db"
      ],
      "enabled": false
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false
    },
    "local_filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./my_project_dir"
      ],
      "enabled": false
    },
    "tree-sitter": {
      "command": "sh",
      "args": [
        "-c",
        "./web-cli/.venv/bin/mcp-server-tree-sitter | grep --line-buffered -E '^\\{'"
      ],
      "enabled": false,
      "auto_init": [
        {
          "tool": "register_project_tool",
          "arguments": {
            "path": "${workdir}",
            "name": "."
          }
        }
      ]
    }
  }
}