# ---------------------------------------------------------------------------
# AiEngine — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LLM Provider (required — pick one)
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (alternative multi-model gateway)
# OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Model selection (optional — overrides code defaults)
# ---------------------------------------------------------------------------

# Default model used when none is passed to LightweightEngine()
# Examples: gpt-4o, gpt-4o-mini, o3-mini, z-ai/glm4.7
# AIENGINE_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Ollama (local inference — optional)
# ---------------------------------------------------------------------------

# Host for Ollama API (context length is auto-detected via /api/show)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# ---------------------------------------------------------------------------
# Agent behaviour (optional)
# ---------------------------------------------------------------------------

# Maximum number of ReAct iterations before the engine halts
# AIENGINE_MAX_ITERATIONS=20

# Maximum messages kept in rolling history window
# AIENGINE_MAX_HISTORY=40

# Working directory sandbox for built-in file/bash tools
# AIENGINE_WORKDIR=/tmp/agent-workdir

# ---------------------------------------------------------------------------
# MCP servers (optional)
# ---------------------------------------------------------------------------

# Path to an MCP server configuration file (JSON)
# See src/mcp_config.json for the expected format.
# MCP_CONFIG_PATH=mcp_config.json
